<Window x:Class="DictationApp.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DictationApp.History"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:HistoryViewModel}"
        Title="DictationApp history" Width="900" Height="600" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource SurfaceAltBrush}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Search" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
        <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_OnKeyDown" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="14,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource SurfaceAltBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock Text="{Binding Footer}" Foreground="{StaticResource MutedTextBrush}" />
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="300" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="2*" MinWidth="260" />
      </Grid.ColumnDefinitions>
      <ListView Grid.Column="0" ItemsSource="{Binding Records}" SelectedItem="{Binding Selected}" BorderThickness="0" SelectionMode="Single">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="When" Width="130" DisplayMemberBinding="{Binding CreatedAt, StringFormat='{}{0:dd MMM HH:mm}', ConverterCulture=en-GB}" />
            <GridViewColumn Header="App" Width="90" DisplayMemberBinding="{Binding ProcessName}" />
            <GridViewColumn Header="Status" Width="90">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" FontWeight="SemiBold" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Text" Width="360">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding InsertedText}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />
      <Grid Grid.Column="2" Margin="14,10" DataContext="{Binding}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
          <Button Content="{Binding IsPlaying, Converter={StaticResource PlayLabel}}" Command="{Binding PlayOrStopCommand}" IsEnabled="{Binding CanPlay}" />
          <Button Content="Copy" Command="{Binding CopyCommand}" />
          <Button Content="Re-insert" Command="{Binding ReInsertCommand}" ToolTip="Hides this window and pastes into the window that gets focus" />
          <Button Content="Retry" Command="{Binding RetryCommand}" IsEnabled="{Binding CanRetry}" ToolTip="Re-stream the stored audio (failed or pending dictations)" />
          <Button Content="Undo AI edit" Command="{Binding UndoAiEditCommand}" IsEnabled="{Binding CanUndo}" ToolTip="Copies the raw transcript so you can paste it over the cleaned text" />
          <Button Content="Delete" Command="{Binding DeleteCommand}" />
        </WrapPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource Heading}" Text="Inserted text" />
        <TextBox Grid.Row="2" Text="{Binding Selected.InsertedText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
        <TextBlock Grid.Row="3" Style="{StaticResource Heading}" Text="Raw transcript" Margin="0,10,0,8" />
        <TextBox Grid.Row="4" Text="{Binding Selected.RawTranscript, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Foreground="{StaticResource MutedTextBrush}" />
        <StackPanel Grid.Row="5" Margin="0,8,0,0">
          <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap">
            <Run Text="{Binding Selected.WindowTitle, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap">
            <Run Text="Tone " /><Run Text="{Binding Selected.Tone, Mode=OneWay}" />
            <Run Text=" · Cleanup " /><Run Text="{Binding Selected.Level, Mode=OneWay}" />
            <Run Text=" · Model " /><Run Text="{Binding Selected.LlmModel, Mode=OneWay, TargetNullValue=none}" />
            <Run Text=" · Audio " /><Run Text="{Binding Selected.DurationMs, Mode=OneWay, StringFormat='{}{0} ms'}" />
            <Run Text=" · Cost $" /><Run Text="{Binding Selected.CostEstimate, Mode=OneWay, StringFormat='{}{0:0.0000}', TargetNullValue=0}" />
          </TextBlock>
          <TextBlock Foreground="{StaticResource RecordingBrush}" FontSize="11" TextWrapping="Wrap" Text="{Binding Selected.FailureReason, Mode=OneWay}" Visibility="{Binding Selected.FailureReason, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
