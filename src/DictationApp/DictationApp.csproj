<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DictationApp</RootNamespace>
    <AssemblyName>DictationApp</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\build\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>DictationApp.Program</StartupObject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Description>Hold-to-talk dictation for Windows built on AssemblyAI.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DictationApp.Core\DictationApp.Core.csproj" />
    <ProjectReference Include="..\DictationApp.Windows\DictationApp.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\build\app.ico" Link="Assets\app.ico" />
  </ItemGroup>
</Project>
